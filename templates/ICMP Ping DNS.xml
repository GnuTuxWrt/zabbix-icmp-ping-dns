                                    <expression>max(/ICMP Ping DNS/icmpping[{#IP}],3)=0</expression>
                                    <name>ICMP Ping: Unavailable by ICMP ping {#IP}</name>
                                    <priority>HIGH</priority>
                                    <description>Last three attempts returned timeout. Please check device connectivity.</description>
                                    <tags>
                                        <tag>
                                            <tag>scope</tag>
                                            <value>availability</value>
                                        </tag>
                                    </tags>
                                </trigger_prototype>
                            </trigger_prototypes>
                        </item_prototype>
                    </item_prototypes>
