                    <item_prototypes>
                        <item_prototype>
                            <uuid>4d4a05e1b20d48e8a85fb2e3c28840c7</uuid>
                            <name>ICMP loss {#IP}</name>
                            <type>SIMPLE</type>
                            <key>icmppingloss[{#IP}]</key>
                            <value_type>FLOAT</value_type>
                            <units>%</units>
                            <description>The percentage of lost packets.</description>
                            <tags>
                                <tag>
                                    <tag>component</tag>
                                    <value>health</value>
                                </tag>
                                <tag>
                                    <tag>component</tag>
                                    <value>network</value>
                                </tag>
                            </tags>
                            <trigger_prototypes>
                                <trigger_prototype>
                                    <uuid>4f702dfa75a14049b9c073e375f20e68</uuid>
                                    <expression>min(/ICMP Ping DNS/icmppingloss[{#IP}],5m)&gt;{$ICMP_LOSS_WARN} and min(/ICMP Ping DNS/icmppingloss[{#IP}],5m)&lt;100</expression>
                                    <name>ICMP Ping: High ICMP ping loss {#IP}</name>
                                    <opdata>Loss: {ITEM.LASTVALUE1}</opdata>
                                    <priority>WARNING</priority>
                                    <description>ICMP packets loss detected.</description>
                                    <dependencies>
                                        <dependency>
                                            <name>ICMP Ping: Unavailable by ICMP ping {#IP}</name>
                                            <expression>max(/ICMP Ping DNS/icmpping[{#IP}],3)=0</expression>
                                        </dependency>
                                    </dependencies>
                                    <tags>
                                        <tag>
                                            <tag>scope</tag>
                                            <value>availability</value>
                                        </tag>
                                        <tag>
                                            <tag>scope</tag>
                                            <value>performance</value>
                                        </tag>
                                    </tags>
                                </trigger_prototype>
                            </trigger_prototypes>
                        </item_prototype>
                        <item_prototype>
                            <uuid>c68815ab697c46eaa97f1a0dd10cec3d</uuid>
                            <name>ICMP response time {#IP}</name>
                            <type>SIMPLE</type>
                            <key>icmppingsec[{#IP}]</key>
                            <value_type>FLOAT</value_type>
                            <units>s</units>
                            <description>The ICMP ping response time (in seconds).</description>
                            <tags>
                                <tag>
                                    <tag>component</tag>
                                    <value>health</value>
                                </tag>
                                <tag>
                                    <tag>component</tag>
                                    <value>network</value>
                                </tag>
                            </tags>
                            <trigger_prototypes>
                                <trigger_prototype>
                                    <uuid>f9257a0f35ce422fa6c0afcfa5ad015f</uuid>
                                    <expression>avg(/ICMP Ping DNS/icmppingsec[{#IP}],5m)&gt;{$ICMP_RESPONSE_TIME_WARN}</expression>
                                    <name>ICMP Ping: High ICMP ping response time {#IP}</name>
                                    <opdata>Value: {ITEM.LASTVALUE1}</opdata>
                                    <priority>WARNING</priority>
                                    <description>Average ICMP response time is too high.</description>
                                    <dependencies>
                                        <dependency>
                                            <name>ICMP Ping: High ICMP ping loss {#IP}</name>
                                            <expression>min(/ICMP Ping DNS/icmppingloss[{#IP}],5m)&gt;{$ICMP_LOSS_WARN} and min(/ICMP Ping DNS/icmppingloss[{#IP}],5m)&lt;100</expression>
                                        </dependency>
                                        <dependency>
                                            <name>ICMP Ping: Unavailable by ICMP ping {#IP}</name>
                                            <expression>max(/ICMP Ping DNS/icmpping[{#IP}],3)=0</expression>
                                        </dependency>
                                    </dependencies>
                                    <tags>
                                        <tag>
                                            <tag>scope</tag>
                                            <value>availability</value>
                                        </tag>
                                        <tag>
                                            <tag>scope</tag>
                                            <value>performance</value>
                                        </tag>
                                    </tags>
                                </trigger_prototype>
                            </trigger_prototypes>
                        </item_prototype>
                        <item_prototype>
                            <uuid>82d2a1d12f0a4cac833230ac4c9698f8</uuid>
                            <name>ICMP ping {#IP}</name>
                            <type>SIMPLE</type>
                            <key>icmpping[{#IP}]</key>
                            <description>The host accessibility by ICMP ping.

0 - ICMP ping fails;
1 - ICMP ping successful.</description>
                            <valuemap>
                                <name>Service state</name>
                            </valuemap>
                            <tags>
                                <tag>
                                    <tag>component</tag>
                                    <value>health</value>
                                </tag>
