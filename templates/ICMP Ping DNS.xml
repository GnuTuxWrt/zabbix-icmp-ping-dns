                    <key>net.dns.record.deduplicated</key>
                    <value_type>TEXT</value_type>
                    <trends>0</trends>
                    <params>concat(last(/{HOST.HOST}/net.dns.record[8.8.4.4,{HOST.HOST},A]),last(/{HOST.HOST}/net.dns.record[8.8.4.4,{HOST.HOST},AAAA]),last(/{HOST.HOST}/net.dns.record[2001:4860:4860::8844,{HOST.HOST},A]),last(/{HOST.HOST}/net.dns.record[2001:4860:4860::8844,{HOST.HOST},AAAA]),last(/{HOST.HOST}/net.dns.record[8.8.8.8,{HOST.HOST},A]),last(/{HOST.HOST}/net.dns.record[8.8.8.8,{HOST.HOST},AAAA]),last(/{HOST.HOST}/net.dns.record[2001:4860:4860::8888,{HOST.HOST},A]),last(/{HOST.HOST}/net.dns.record[2001:4860:4860::8888,{HOST.HOST},AAAA]))</params>
                    <preprocessing>
                        <step>
                            <type>STR_REPLACE</type>
                            <parameters>
                                <parameter>[]</parameter>
                                <parameter/>
                            </parameters>
                        </step>
                        <step>
                            <type>STR_REPLACE</type>
                            <parameters>
                                <parameter>][</parameter>
                                <parameter>,</parameter>
                            </parameters>
                        </step>
                        <step>
                            <type>JAVASCRIPT</type>
                            <parameters>
                                <parameter>var s={};return JSON.stringify(JSON.parse(value).filter(function(o){return!s[o.ip]&amp;&amp;(s[o.ip]=1);}));</parameter>
                            </parameters>
                        </step>
                    </preprocessing>
